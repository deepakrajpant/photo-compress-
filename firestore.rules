rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function admin(){ return signedIn() && request.auth.token.email == 'deepakrajpant978@gmail.com' && request.auth.token.email_verified == true; }
  function owner(uid){return signedIn() && request.auth.uid == uid;}
  match /users/{uid} {
   allow read: if owner(uid) || admin();
   allow create: if owner(uid)
    && request.resource.data.keys().hasOnly(['name','email','photoURL','emailVerified','role','status','practiceAccess','premium','bookmarks','streak','bestScore','createdAt','lastLogin'])
    && request.resource.data.role == 'student' && request.resource.data.status == 'active'
    && request.resource.data.premium == null && request.resource.data.practiceAccess == false
    && request.resource.data.bestScore == 0
    && request.resource.data.bookmarks is list && request.resource.data.bookmarks.size() == 0
    && request.resource.data.streak == {'count':0,'last':null}
    && request.resource.data.email == request.auth.token.email;
   allow update: if admin() || (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoURL','lastLogin','bookmarks','streak']) && request.resource.data.bookmarks is list && request.resource.data.bookmarks.size() <= 1000);
   allow delete: if admin();
   match /results/{attemptId} {allow read: if owner(uid) || admin();allow write: if false;}
  }
  match /accessRequests/{rid} {
   allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
   allow update: if admin() && resource.data.status == 'pending' && request.resource.data.status == 'rejected' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt']);
   allow create,delete: if false;
  }
  match /plans/{id} {allow read: if true;allow write: if admin();}
  match /appConfig/{id} {allow read: if true;allow write: if admin();}
  // Only callable functions expose paid questions after checking membership and browser binding.
  match /jftoctnovset/{id} {allow read,write: if admin();}
  match /leaderboard/{id} {allow read: if signedIn();allow write: if false;}
  match /adminAuditLogs/{id} {allow read: if admin();allow create: if admin();allow update,delete: if false;}
  match /deviceBindings/{id} {allow read,write: if false;}
  match /serverAttempts/{id} {allow read,write: if false;}
  match /{document=**} {allow read,write: if false;}
 }
}
